{
  "name": "vue-nav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "基于 Vue 3 的静态网址导航站，支持站内搜索与多搜索引擎切换，可一键部署到 GitHub Pages",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -b",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.132",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.0"
  }
}
